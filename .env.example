# Public market-data app ID for the legacy public tick stream
NEXT_PUBLIC_DERIV_APP_ID=YOUR_DERIV_APP_ID

# OAuth client ID from your registered Deriv application
NEXT_PUBLIC_DERIV_OAUTH_CLIENT_ID=YOUR_DERIV_OAUTH_CLIENT_ID
DERIV_OAUTH_CLIENT_ID=YOUR_DERIV_OAUTH_CLIENT_ID

# Must exactly match the redirect URI registered with Deriv
NEXT_PUBLIC_DERIV_REDIRECT_URI=http://localhost:3000/auth/callback
DERIV_OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback

# Never put OAuth access tokens or personal access tokens in NEXT_PUBLIC variables.
